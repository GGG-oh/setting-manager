document.getElementById('goBack').onclick=()=>nav('characters');
document.querySelectorAll('[data-gal]').forEach(b=>b.onclick=()=>openLightbox(gal,Number(b.dataset.gal)));
document.getElementById('galOpen')?.addEventListener('click',()=>openLightbox(gal,0));
