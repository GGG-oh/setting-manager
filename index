 el.innerHTML=`<div class="relFullTop"><button class="btn ghost" id="relBack">← ${relBack==='detail'?'캐릭터 문서':'관계 목록'}</button><button class="btn" id="relEdit">관계 수정</button></div>
<div class="eyebrow">${esc(folder)} / 관계 상세</div><h1 class="relFullTitle">${esc(title)}</h1>
<div class="relFull">${person(r.from)}<div class="relFullMid"><div class="relFullType">${esc(r.type||'관계')}</div><div class="relFullLine"><span></span></div></div>${person(r.to)}</div>
<section class="relFullNote"><h3>관계 설명</h3><div class="prose">${esc(r.note||'아직 작성된 설명이 없습니다.')}</div></section>`;
 document.getElementById('relBack').onclick=()=>nav(relBack==='detail'?'detail':'relations');
 document.getElementById('relEdit').onclick=()=>editRelation(r.id);
 document.querySelectorAll('[data-open-person]').forEach(b=>b.onclick=()=>showCharacter(b.dataset.openPerson));
}
function renderOverview(){el.innerHTML=`<div class="hero"><div><div class="eyebrow">OVERVIEW / 전체 현황</div><h1>전체 현황</h1><div class="muted">현재 등록된 설정을 한눈에 확인합니다.</div></div></div><div class="statrow"><div class="stat">캐릭터<b>${db.characters.length}</b></div><div class="stat">세계관<b>${db.worlds.length}</b></div><div class="stat">관계<b>${db.relations.length}</b></div><div class="stat">이미지 등록<b>${db.characters.filter(c=>c.image).length}</b></div></div><div class="panel" style="margin-top:20px"><h2>데이터 관리</h2><p class="muted">데이터는 현재 브라우저에 저장됩니다. 중요한 설정은 주기적으로 백업해 주세요.</p><div class="actions" style="justify-content:flex-start"><button class="btn" id="export2">JSON 백업</button><button class="btn" id="import2">백업 불러오기</button></div></div>`;document.getElementById('export2').onclick=()=>document.getElementById('backup').click();document.getElementById('import2').onclick=()=>document.getElementById('restoreInput').click()}
document.getElementById('restoreInput').onchange=async e=>{let f=e.target.files[0];if(!f)return;try{let d=JSON.parse(await f.text());if(!Array.isArray(d.characters)||!Array.isArray(d.worlds)||!Array.isArray(d.relations))throw Error();if(confirm('현재 데이터를 백업 파일로 교체할까요? 기존 데이터는 덮어씌워집니다.')){db={...blank(),...d};save();render();alert('불러왔습니다.')}}catch(e){alert('올바른 백업 파일이 아닙니다.')}e.target.value=''};
function openDrawer(body,title){document.getElementById('modal').innerHTML=`<div class="overlay" id="overlay"><div class="drawer"><div class="drawerhead"><b>${esc(title)}</b><button class="btn" id="close">닫기 ✕</button></div><div class="drawercontent">${body}</div></div></div>`;document.getElementById('close').onclick=closeDrawer;document.getElementById('overlay').onclick=e=>{if(e.target.id==='overlay')closeDrawer()}}
function closeDrawer(){document.getElementById('modal').innerHTML=''}
function editWorld(wid){let w=db.worlds.find(x=>x.id===wid)||{name:'',description:''};openDrawer(`<form id="worldForm"><div class="field"><label>세계관 이름 *</label><input name="name" required maxlength="100" value="${esc(w.name)}"></div><div class="field"><label>세계관 설명</label><textarea name="description">${esc(w.description)}</textarea></div><div class="actions">${wid?'<button type="button" class="btn red" id="delWorld">삭제</button>':''}<button class="btn dark">저장</button></div></form>`,wid?'세계관 수정':'세계관 추가');document.getElementById('worldForm').onsubmit=e=>{e.preventDefault();let f=new FormData(e.target);if(wid)Object.assign(w,{name:f.get('name').trim(),description:f.get('description')});else db.worlds.push({id:id(),name:f.get('name').trim(),description:f.get('description')});save();closeDrawer();render()};document.getElementById('delWorld')?.addEventListener('click',()=>{if(confirm('이 세계관을 삭제할까요? 소속 캐릭터은 미분류로 이동합니다.')){db.worlds=db.worlds.filter(x=>x.id!==wid);db.characters.forEach(c=>{if(c.worldId===wid)c.worldId=''});save();closeDrawer();render()}})}
const fields=[['name','이름 *'],['alias','별칭'],['birthday','생일','예: 3월 14일'],['species','종족'],['age','나이'],['role','역할'],['tags','태그 (쉼표로 구분)'],['summary','한 줄 소개']];
const texts=[['appearance','외형'],['personality','성격'],['history','과거와 서사'],['notes','추가 메모']];
function editCharacter(cid){let c=db.characters.find(x=>x.id===cid)||{};let image=c.image||'';let gallery=[...(c.gallery||[])];let body=`<form id="charForm"><div class="field"><label>대표 이미지</label><input type="file" id="pic" accept="image/*"><div id="preview">${image?`<img src="${image}" style="max-height:160px;max-width:180px;border-radius:9px;margin-top:8px">`:''}</div><button type="button" class="btn" id="removePic" style="align-self:flex-start">이미지 제거</button></div><div class="field"><label>세계관</label><select name="worldId"><option value="">미분류</option>${db.worlds.map(w=>`<option value="${esc(w.id)}" ${c.worldId===w.id?'selected':''}>${esc(w.name)}</option>`).join('')}</select></div><div class="field"><label>소속</label><div style="display:flex;gap:8px"><select name="affiliation" id="affiliationSelect" style="flex:1"><option value="">소속 없음</option>${[...new Set([...db.affiliations.map(a=>a.name),...(c.affiliation?[c.affiliation]:[])])].map(a=>`<option value="${esc(a)}" ${c.affiliation===a?'selected':''}>${esc(a)}</option>`).join('')}</select><button type="button" class="btn" id="addAffiliation">+ 새 소속</button></div><div class="tiny muted">새 소속을 만들면 다른 캐릭터에게도 선택할 수 있어요.</div></div><div class="cols">${fields.map(([key,label,ph])=>`<div class="field"><label>${label}</label><input name="${key}" ${key==='name'?'required':''} value="${esc(c[key]||'')}" placeholder="${esc(ph||'')}"></div>`).join('')}</div>${texts.map(([key,label])=>`<div class="field"><label>${label}</label><textarea name="${key}">${esc(c[key]||'')}</textarea></div>`).join('')}<div class="field"><label>갤러리 <span class="muted tiny">다른 그림들 · 여러 장 선택 가능</span></label><input type="file" id="galleryPic" accept="image/*" multiple><div class="galleryEdit" id="galleryEdit"></div><div class="tiny muted">사진은 자동으로 줄여서 저장돼요. 많이 올리면 브라우저 저장 공간이 찰 수 있으니 백업을 자주 해주세요.</div></div><div class="actions">${cid?'<button type="button" class="btn red" id="delChar">캐릭터 삭제</button>':''}<button class="btn dark">저장</button></div></form>`;
