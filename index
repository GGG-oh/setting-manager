<!doctype html>
<html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#09090a"><meta name="color-scheme" content="dark">
<title>설정 관리</title>
<style>
@font-face{font-family:"Diphylleia";src:url("data:font/ttf;base64,") format("truetype");font-weight:400;font-style:normal;font-display:swap;}
/* ============ NOIR / ACID — 설정 관리 ============ */
:root{
  --bg:#09090a;--bg2:#0e0e10;--paper:#131316;--paper2:#1a1a1e;
  --ink:#f3f1ea;--sub:#8c8c88;--dim:#55555a;
  --line:#232328;--line2:#34343b;
  --acc:#2b5bff;--acc-ink:#ffffff;--acc-text:#6f8fff;--accent:#2b5bff;--danger:#ff5b4d;
  --display:"Diphylleia",serif;
  --sans:"Pretendard","Apple SD Gothic Neo","Noto Sans KR","Malgun Gothic",system-ui,-apple-system,sans-serif;
  --radius:8px;--control-height:42px;--content-width:1200px;
}
*{box-sizing:border-box}
html{color-scheme:dark;scroll-behavior:smooth}
body{
  margin:0;color:var(--ink);font-family:var(--sans);font-size:14px;line-height:1.5;
  -webkit-font-smoothing:antialiased;font-synthesis:none;
  background:
    radial-gradient(900px 520px at 8% -8%,#2b5bff2e,transparent 62%),
    radial-gradient(700px 480px at 100% 0%,#6c5cff10,transparent 60%),
    var(--bg);
  background-attachment:fixed;
}
/* 필름 그레인 */
body::after{
  content:"";position:fixed;inset:0;pointer-events:none;z-index:100;opacity:.08;mix-blend-mode:overlay;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
}
::selection{background:var(--acc);color:var(--acc-ink)}
::-webkit-scrollbar{width:10px;height:10px}
::-webkit-scrollbar-thumb{background:#2a2a30;border-radius:99px;border:2px solid transparent;background-clip:content-box}
::-webkit-scrollbar-thumb:hover{background:#3a3a42;background-clip:content-box;border:2px solid transparent}
::-webkit-scrollbar-track{background:transparent}
button,input,textarea,select{font:inherit;color:inherit}
button{cursor:pointer}
button:disabled{opacity:.4;cursor:default}
p{line-height:1.7}
a{color:inherit}
.hidden{display:none!important}
.muted{color:var(--sub)}
.tiny{font-size:12px}
.mobileonly{display:none}

/* ---------- 헤더 ---------- */
header{
  height:72px;display:flex;align-items:center;gap:36px;padding:0 5vw;
  position:sticky;top:0;z-index:10;
  background:#09090acc;backdrop-filter:blur(16px) saturate(140%);-webkit-backdrop-filter:blur(16px) saturate(140%);
  border-bottom:1px solid var(--line);
}
.logo{font-family:var(--display);font-size:24px;font-weight:400;letter-spacing:-.04em;white-space:nowrap}
.logo span{color:var(--acc-text)!important}
.nav{display:flex;gap:28px;align-items:center;height:100%}
.nav button{
  height:100%;border:0;background:none;color:var(--sub);padding:0;font-size:15px;white-space:nowrap;
  border-bottom:2px solid transparent;border-top:2px solid transparent;transition:color .15s;
}
.nav button:hover{color:var(--ink)}
.nav button.on{color:var(--ink);border-bottom-color:var(--acc-text)}
.right{margin-left:auto;display:flex;gap:8px}

/* ---------- 버튼 ---------- */
.btn,.chip{min-height:var(--control-height);display:inline-flex;align-items:center;justify-content:center;white-space:nowrap}
.btn{
  border:1px solid var(--line2);background:transparent;color:var(--ink);border-radius:999px;padding:0 20px;
  transition:background .15s,border-color .15s,box-shadow .2s,transform .1s;
}
.btn:hover{border-color:var(--ink);background:#ffffff0d}
.btn:active{transform:scale(.97)}
.btn.dark{background:var(--acc);border-color:var(--acc-text);color:var(--acc-ink);font-weight:700}
.btn.dark:hover{background:#4f78ff;border-color:#4f78ff;box-shadow:0 0 28px #2b5bff80}
.btn.ghost{border-color:transparent;padding:0 14px;color:var(--sub)}
.btn.ghost:hover{background:#ffffff0d;border-color:transparent;color:var(--ink)}
.btn.red{color:var(--danger);border-color:#ff5b4d44}
.btn.red:hover{background:#ff5b4d14;border-color:var(--danger)}

/* ---------- 레이아웃 ---------- */
main{max-width:calc(var(--content-width) + 10vw);width:100%;margin:0 auto;padding:56px 5vw 110px;min-height:calc(100vh - 72px)}
.eyebrow{
  display:flex;align-items:center;gap:10px;font-size:11px;color:var(--sub);
  letter-spacing:.22em;text-transform:uppercase;margin-bottom:16px;
}
.eyebrow::before{content:"";width:22px;height:1px;background:var(--acc);flex-shrink:0}
.hero{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:44px;min-height:120px}
.heroActions{display:flex;gap:8px;flex-wrap:wrap}
h1{
  font-family:var(--display);font-weight:400;font-size:clamp(46px,7.4vw,96px);
  letter-spacing:-.045em;line-height:1;margin:0 0 16px;
}
h1+.muted,.hero .muted{font-size:14px;max-width:520px}

/* ---------- 툴바 ---------- */
.toolbar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:30px}
.search{
  padding:0 20px;height:var(--control-height);border:1px solid var(--line2);border-radius:999px;
  background:var(--paper);color:var(--ink);min-width:240px;flex:1;max-width:420px;outline:none;
  transition:border-color .15s,box-shadow .15s;
}
.search::placeholder,input::placeholder,textarea::placeholder{color:var(--dim)}
.chip{
  border:1px solid var(--line2);border-radius:999px;padding:0 17px;background:transparent;color:var(--sub);
  transition:color .15s,border-color .15s,background .15s;
}
.chip:hover{color:var(--ink);border-color:var(--ink)}
.chip.active{color:var(--acc-text);border-color:var(--acc-text);background:#2b5bff24}
.count{color:var(--sub);margin-left:auto;font-size:12px;letter-spacing:.1em}

/* ---------- 캐릭터 카드 ---------- */
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:20px;counter-reset:card}
.character{
  counter-increment:card;position:relative;border:1px solid var(--line);background:var(--paper);
  border-radius:var(--radius);overflow:hidden;cursor:pointer;
  transition:transform .25s cubic-bezier(.2,.8,.2,1),border-color .2s,box-shadow .25s;
}
.character:hover{transform:translateY(-6px);border-color:var(--acc-text);box-shadow:0 0 0 1px #2b5bff4d,0 24px 60px #000000b0,0 0 40px #2b5bff24}
.portrait{height:270px;background:var(--paper2);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}
.portrait img{width:100%;height:100%;object-fit:cover;filter:grayscale(1) contrast(1.08) brightness(.88);transform:scale(1.001);transition:filter .45s,transform .6s cubic-bezier(.2,.8,.2,1)}
.character:hover .portrait img{filter:none;transform:scale(1.06)}
.portrait::before{content:"";position:absolute;inset:auto 0 0 0;height:55%;background:linear-gradient(to top,var(--paper),transparent);z-index:1;pointer-events:none}
.portrait::after{
  content:attr(data-no);position:absolute;right:14px;top:12px;z-index:2;
  font-family:var(--display);font-size:15px;color:#ffffffb0;letter-spacing:.05em;
}
.portrait .initial{font-family:var(--display);font-size:110px;color:#2c2c32;line-height:1}
.portrait .flag{
  position:absolute;left:12px;top:12px;z-index:2;background:#000000a0;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);
  border:1px solid #ffffff1c;color:var(--ink);border-radius:999px;padding:5px 11px;font-size:11px;letter-spacing:.04em;
}
.cardbody{padding:4px 20px 22px;position:relative;z-index:2}
.cardbody h3{font-family:var(--display);font-weight:400;font-size:24px;letter-spacing:-.03em;margin:0 0 7px}
.cardbody p{margin:0;color:var(--sub);font-size:12px}
.tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:16px}
.tag{border:1px solid var(--line2);color:var(--sub);padding:3px 10px;border-radius:999px;font-size:11px}
.empty{
  grid-column:1/-1;text-align:center;border:1px dashed var(--line2);border-radius:12px;
  padding:90px 20px;color:var(--sub);
}
.empty div:first-child{color:var(--acc-text)}
.empty .btn{margin-top:14px}

/* ---------- 세계관 ---------- */
.worldgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:18px}
.worldcard{
  background:var(--paper);border:1px solid var(--line);padding:28px;border-radius:var(--radius);cursor:pointer;min-height:190px;
  transition:border-color .2s,transform .25s cubic-bezier(.2,.8,.2,1),box-shadow .25s;
}
.worldcard:hover{border-color:var(--acc-text);transform:translateY(-4px);box-shadow:0 20px 50px #000a}
.worldcard h3{font-family:var(--display);font-weight:400;font-size:28px;letter-spacing:-.03em;margin:0 0 10px}
.worldcard p{margin:0;color:var(--sub)}
#worldCreate{background:transparent}
#worldCreate h3{color:var(--sub)}
#worldCreate:hover h3{color:var(--acc-text)}

/* ---------- 전체 현황 ---------- */
.statrow{display:flex;gap:14px;flex-wrap:wrap}
.stat{flex:1;min-width:170px;background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:26px;color:var(--sub);font-size:12px;letter-spacing:.14em}
.stat b{display:block;font-family:var(--display);font-weight:400;font-size:68px;line-height:1;letter-spacing:-.04em;margin-top:18px;color:var(--acc-text)}
.panel{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:30px;margin-bottom:18px}
.panel h2{font-family:var(--display);font-weight:400;margin:0 0 16px;font-size:26px;letter-spacing:-.03em}

/* ---------- 폼 ---------- */
.field{display:flex;flex-direction:column;gap:8px;margin-bottom:20px}
.field label{font-weight:600;font-size:12px;color:var(--sub);letter-spacing:.08em}
input,textarea,select{outline:none}
.field input,.field select,.field textarea,.editorPerson select{
  border:1px solid var(--line2);border-radius:6px;background:var(--paper2);padding:12px 14px;width:100%;color:var(--ink);
  transition:border-color .15s,box-shadow .15s;
}
.field input,.field select{min-height:44px}
.field textarea{min-height:110px;resize:vertical;line-height:1.7}
.field input[type=file]{padding:9px;color:var(--sub)}
input:focus,textarea:focus,select:focus,.search:focus{border-color:var(--acc-text)!important;box-shadow:0 0 0 3px #2b5bff38}
select option{background:var(--paper2);color:var(--ink)}
.cols{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.actions{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;margin-top:26px}
.divider{height:1px;background:var(--line);margin:22px 0}
.notice{padding:12px;background:var(--paper2);border-radius:8px;color:var(--sub);font-size:12px;line-height:1.6}
.prose{white-space:pre-wrap;line-height:1.85}

/* ---------- 드로어 ---------- */
@keyframes fadeIn{from{opacity:0}}
@keyframes slideIn{from{transform:translateX(40px);opacity:0}}
.overlay{position:fixed;inset:0;background:#000000b8;backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);z-index:30;display:flex;justify-content:flex-end;animation:fadeIn .2s}
.drawer{width:min(720px,100%);min-width:0;height:100%;overflow:auto;background:var(--bg2);border-left:1px solid var(--line2);box-shadow:-30px 0 80px #000;animation:slideIn .35s cubic-bezier(.2,.8,.2,1)}
.drawerhead{
  background:#0e0e10d9;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--line);
  padding:18px 32px;display:flex;align-items:center;justify-content:space-between;gap:15px;position:sticky;top:0;z-index:2;
}
.drawerhead b{font-family:var(--display);font-weight:400;font-size:20px;letter-spacing:-.02em}
.drawercontent{padding:32px;max-width:720px;margin:auto}

/* ---------- 관계 ---------- */
.relationList{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;min-height:100px}
.relationListItem{
  width:100%;min-height:92px;display:flex;justify-content:space-between;align-items:center;gap:20px;padding:20px 28px;
  border:0;border-bottom:1px solid var(--line);background:transparent;text-align:left;color:var(--ink);
  transition:background .15s,box-shadow .15s;
}
.relationListItem:last-child{border-bottom:0}
.relationListItem:hover{background:var(--paper2);box-shadow:inset 3px 0 0 var(--acc)}
.relationListMain{display:flex;flex-direction:column;gap:8px;min-width:0}
.relationListMain strong{font-family:var(--display);font-size:22px;font-weight:400;letter-spacing:-.03em;overflow-wrap:anywhere}
.relationListSub{font-size:12px;color:var(--sub)}
.relationListArrow{font-size:12px;color:var(--dim);white-space:nowrap;transition:color .15s,transform .2s}
.relationListItem:hover .relationListArrow{color:var(--acc-text);transform:translateX(4px)}
.pairDetailTitle{font-family:var(--display);font-weight:400;font-size:clamp(30px,5vw,44px);letter-spacing:-.04em;line-height:1.1;margin:12px 0 28px;overflow-wrap:anywhere}
.relationDetailPair{display:flex;align-items:center;justify-content:space-between;gap:14px;margin:22px 0 30px}
.relationPerson{
  background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);flex:1;min-width:0;display:flex;align-items:center;
  flex-direction:column;gap:8px;padding:16px 10px;color:var(--ink);transition:border-color .2s,transform .2s;
}
.relationPerson:hover{border-color:var(--acc-text);transform:translateY(-3px)}
.relationPersonPhoto{height:150px;width:min(100%,130px);border-radius:6px;overflow:hidden;background:var(--paper2);display:grid;place-items:center;font-family:var(--display);font-size:54px;color:#34343a}
.relationPersonPhoto img{height:100%;width:100%;object-fit:cover}
.relationPerson strong{font-family:var(--display);font-weight:400;font-size:20px;overflow-wrap:anywhere;text-align:center}
.relationPerson small{color:var(--sub);text-align:center}
.profileLink{font-size:12px;color:var(--acc-text)}
.relationDetailMiddle{text-align:center;min-width:78px;max-width:110px;overflow-wrap:anywhere}
.relationDetailType{font-family:var(--display);font-size:18px}
.relationDetailArrow{font-size:30px;color:var(--acc-text);margin-top:8px}
.relationNote{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:24px;min-height:125px}
.relationNote h3{font-size:11px;font-weight:600;letter-spacing:.2em;color:var(--sub);margin:0 0 16px}

/* ---------- 캐릭터 문서(위키) ---------- */
.wikiNav{display:flex;align-items:center;justify-content:space-between;margin-bottom:22px}
.wikiLayout{display:grid;grid-template-columns:190px minmax(0,1fr);gap:22px;align-items:start}
.wikiToc{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:18px;position:sticky;top:96px;display:flex;flex-direction:column;gap:2px}
.wikiTocTitle{font-family:var(--display);font-size:18px;border-bottom:1px solid var(--line);padding-bottom:14px;margin-bottom:8px}
.wikiToc a{color:var(--sub);text-decoration:none;padding:9px 10px;border-left:2px solid transparent;font-size:13px;transition:color .15s,border-color .15s,background .15s}
.wikiToc a:hover{color:var(--acc-text);border-left-color:var(--acc-text);background:#2b5bff1a}
.wikiArticle{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);min-height:700px;padding:42px 46px 80px;min-width:0}
.wikiBread{font-size:11px;color:var(--sub);letter-spacing:.2em;margin-bottom:18px}
.wikiTitle{font-family:var(--display);font-weight:400;font-size:clamp(42px,6.2vw,78px);letter-spacing:-.05em;line-height:1.02;border-bottom:1px solid var(--line);padding-bottom:22px;margin:0 0 14px}
.wikiSubtitle{color:var(--sub);font-size:14px;margin-bottom:30px}
.wikiArticleBody:after{content:'';display:block;clear:both}
.wikiInfobox{float:right;width:290px;margin:0 0 24px 32px;border:1px solid var(--line2);background:var(--paper2);border-radius:var(--radius);overflow:hidden;font-size:13px}
.wikiInfoName{background:var(--acc);color:var(--acc-ink);text-align:center;font-family:var(--display);font-size:24px;letter-spacing:-.03em;padding:14px}
.wikiInfoPortrait{height:290px;background:#0c0c0e;display:grid;place-items:center;overflow:hidden;font-family:var(--display);font-size:80px;color:#2c2c32}
.wikiInfoPortrait img{width:100%;height:100%;object-fit:contain}
.wikiInfoCaption{text-align:center;padding:10px;color:var(--sub);font-size:12px;border-bottom:1px solid var(--line2)}
.wikiInfoRow{display:grid;grid-template-columns:82px minmax(0,1fr);border-bottom:1px solid var(--line);min-height:40px}
.wikiInfoRow:last-child{border-bottom:0}
.wikiInfoRow b{padding:11px 10px;font-weight:500;color:var(--sub);font-size:12px;letter-spacing:.06em}
.wikiInfoRow span{padding:11px 10px;overflow-wrap:anywhere}
.wikiIntro{min-height:260px}
.wikiIntro h2,.wikiSection h2{font-family:var(--display);font-weight:400;font-size:28px;letter-spacing:-.04em;border-bottom:1px solid var(--line);padding-bottom:14px;margin:0 0 20px}
.wikiSection{clear:both;padding-top:34px;scroll-margin-top:100px}
.wikiSectionNumber{color:var(--acc-text)}
.wikiProse{white-space:pre-wrap;line-height:1.95;overflow-wrap:anywhere;min-height:36px;color:#dedcd5}
.wikiRel{
  display:flex;width:100%;align-items:center;justify-content:space-between;padding:15px 16px;background:var(--paper2);color:var(--ink);
  border:1px solid var(--line);border-radius:6px;margin:8px 0;text-align:left;gap:12px;transition:border-color .15s,transform .15s;
}
.wikiRel:hover{border-color:var(--acc-text);transform:translateX(4px)}
.wikiRel span:last-child{color:var(--sub);font-size:12px}

/* ---------- 관계 편집 ---------- */
.editorPage{max-width:1150px;margin:auto}
.editorTop{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:36px}
.editorTopLabel{font-size:11px;color:var(--sub);letter-spacing:.18em}
.editorHeading{margin-bottom:34px}
.editorHeading h1{font-size:clamp(38px,5.4vw,68px);margin-bottom:12px}
.editorHeading p{color:var(--sub);margin:0}
.editorGrid{display:grid;grid-template-columns:minmax(0,1fr) 275px;align-items:start;gap:20px}
.editorPrimary{display:flex;flex-direction:column;gap:18px;min-width:0}
.editorBox,.editorSummary{background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:30px}
.editorSectionTitle{display:flex;align-items:flex-start;gap:16px;margin-bottom:26px}
.editorNumber{border-radius:999px;border:1px solid #2b5bff80;color:var(--acc-text);font-family:var(--display);font-size:13px;padding:7px 12px;letter-spacing:.06em}
.editorSectionTitle h2{font-family:var(--display);font-weight:400;font-size:24px;letter-spacing:-.03em;margin:0 0 6px}
.editorSectionTitle p{font-size:12px;color:var(--sub);margin:0}
.editorPair{display:grid;grid-template-columns:minmax(0,1fr) 65px minmax(0,1fr);gap:12px;align-items:center}
.editorPerson{display:flex;flex-direction:column;gap:9px;min-width:0}
.editorPerson label{font-size:12px;font-weight:600;color:var(--sub);letter-spacing:.08em}
.editorPerson select{min-width:0;min-height:44px}
.editorAvatar{height:200px;border-radius:8px;background:#0c0c0e;border:1px solid var(--line);display:grid;place-items:center;overflow:hidden;color:#2c2c32;font-family:var(--display);font-size:68px}
.editorAvatar img{width:100%;height:100%;object-fit:contain}
.editorBetween{text-align:center;color:var(--acc-text)}
.editorBetween span{font-size:28px;display:block}
.editorBetween small{font-size:11px;color:var(--sub)}
.editorNote{min-height:195px!important}
.editorSecondary{position:sticky;top:96px;display:flex;flex-direction:column;gap:15px}
.editorSummary h2{font-family:var(--display);font-weight:400;font-size:26px;letter-spacing:-.03em;overflow-wrap:anywhere;line-height:1.35;margin:0 0 8px}
.editorSummary p{color:var(--sub);font-size:12px;margin:0}
.editorActions{display:flex;flex-direction:column;gap:9px}
.editorActions .btn{width:100%}

/* ---------- 반응형 ---------- */
@media(max-width:850px){
  .wikiLayout{grid-template-columns:1fr}
  .wikiToc{position:static;flex-direction:row;overflow:auto;align-items:center;white-space:nowrap}
  .wikiTocTitle{border:0;margin:0;padding:0 10px}
  .wikiToc a{border-left:0}
  .wikiArticle{padding:26px}
  .wikiInfobox{width:250px}
  .editorGrid{grid-template-columns:1fr}
  .editorSecondary{position:static}
  .editorSummary{order:0}
  .editorActions{flex-direction:row;flex-wrap:wrap}
  .editorActions .btn{width:auto;flex:1}
}
@media(max-width:720px){
  header{height:auto;padding:14px 5vw 0;flex-wrap:wrap;gap:10px}
  .nav{order:3;width:100%;justify-content:space-between;height:46px;overflow:auto;gap:18px}
  .right{margin-left:auto}
  main{padding-top:36px}
  .hero{align-items:flex-start;margin-bottom:30px}
  .cards{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  .portrait{height:200px}
  .portrait .initial{font-size:80px}
  .cardbody{padding:2px 14px 16px}
  .cardbody h3{font-size:19px}
  .drawercontent{padding:20px}
  .drawerhead{padding:14px 18px}
  .cols{grid-template-columns:1fr}
  .toolbar .count{width:100%}
