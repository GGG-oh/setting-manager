document.getElementById('charForm').onsubmit=e=>{e.preventDefault();let f=new FormData(e.target),v={worldId:f.get('worldId'),affiliation:f.get('affiliation'),image,gallery,updatedAt:new Date().toISOString()};for(let [key] of fields)v[key]=String(f.get(key)||'').trim();for(let [key] of texts)v[key]=String(f.get(key)||'');if(cid)Object.assign(c,v);else db.characters.push({id:id(),...v});save();closeDrawer();render()};
