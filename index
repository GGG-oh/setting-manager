/* ===== 카드 드래그로 순서 변경 (마우스 + 터치 길게 누르기) ===== */
let dragSt=null,suppressClick=false;
function flip(fn){const els=[...document.querySelectorAll('.cards .character')];const first=new Map(els.map(x=>[x,x.getBoundingClientRect()]));fn();els.forEach(x=>{const a=first.get(x),b=x.getBoundingClientRect(),dx=a.left-b.left,dy=a.top-b.top;if(dx||dy)x.animate([{transform:`translate(${dx}px,${dy}px)`},{transform:'none'}],{duration:220,easing:'cubic-bezier(.2,.8,.2,1)'})})}
function dragStart(){
 const s=dragSt;if(!s||s.active)return;s.active=true;
 const r=s.card.getBoundingClientRect();s.dx=s.lx-r.left;s.dy=s.ly-r.top;
 const g=s.card.cloneNode(true);g.classList.add('dragGhost');g.style.width=r.width+'px';g.style.height=r.height+'px';
 document.body.appendChild(g);s.ghost=g;s.card.classList.add('dragging');document.body.classList.add('isDragging');
 if(navigator.vibrate)try{navigator.vibrate(15)}catch(e){}
 dragTick();
}
function dragTick(){
 const s=dragSt;if(!s||!s.active)return;
 s.ghost.style.transform=`translate(${s.lx-s.dx}px,${s.ly-s.dy}px) scale(1.04) rotate(2deg)`;
 if(s.ly<90)window.scrollBy(0,-16);else if(s.ly>innerHeight-90)window.scrollBy(0,16);
 const t=document.elementFromPoint(s.lx,s.ly)?.closest('.cards .character');
 if(t&&t!==s.card){const r=t.getBoundingClientRect(),before=s.lx<r.left+r.width/2;flip(()=>t.parentNode.insertBefore(s.card,before?t:t.nextSibling))}
 s.raf=requestAnimationFrame(dragTick);
}
function dragEnd(){
 const s=dragSt;dragSt=null;if(!s)return;clearTimeout(s.timer);
 if(!s.active)return;cancelAnimationFrame(s.raf);
 s.ghost.remove();s.card.classList.remove('dragging');document.body.classList.remove('isDragging');
 const ids=[...document.querySelectorAll('.cards .character')].map(x=>x.dataset.char);
 const shown=new Set(ids),slots=[];db.characters.forEach((c,i)=>{if(shown.has(c.id))slots.push(i)});
 const byId=new Map(db.characters.map(c=>[c.id,c]));
 slots.forEach((slot,k)=>{db.characters[slot]=byId.get(ids[k])});
 save();suppressClick=true;setTimeout(()=>suppressClick=false,80);renderCharacters();
}
document.addEventListener('pointerdown',e=>{
 const card=e.target.closest?.('#main .cards .character');if(!card||(e.pointerType==='mouse'&&e.button!==0))return;
 const s=dragSt={card,x:e.clientX,y:e.clientY,lx:e.clientX,ly:e.clientY,touch:e.pointerType!=='mouse',active:false};
 if(s.touch)s.timer=setTimeout(()=>{if(dragSt===s)dragStart()},320);
});
document.addEventListener('pointermove',e=>{
 const s=dragSt;if(!s)return;s.lx=e.clientX;s.ly=e.clientY;
 if(s.active)return;
 const d=Math.hypot(e.clientX-s.x,e.clientY-s.y);
 if(s.touch){if(d>8){clearTimeout(s.timer);dragSt=null}}else if(d>6)dragStart();
});
document.addEventListener('pointerup',dragEnd);
document.addEventListener('pointercancel',dragEnd);
document.addEventListener('touchmove',e=>{if(dragSt&&dragSt.active)e.preventDefault()},{passive:false});
document.addEventListener('dragstart',e=>{if(e.target.closest?.('.character'))e.preventDefault()});
document.addEventListener('contextmenu',e=>{if(dragSt&&e.target.closest?.('.character'))e.preventDefault()});

/* ===== 전체 화면 갤러리 ===== */
function openLightbox(list,start=0){
 if(!list.length)return;let i=start;
 const box=document.createElement('div');box.className='lightbox';
 box.innerHTML=`<button class="lbClose" aria-label="닫기">✕</button><div class="lbStage"><button class="lbNav" data-d="-1" ${list.length<2?'hidden':''}>‹</button><img class="lbMain" alt=""><button class="lbNav" data-d="1" ${list.length<2?'hidden':''}>›</button></div><div class="lbCount"></div><div class="lbThumbs">${list.map((s,k)=>`<button class="lbThumb" data-k="${k}"><img src="${s}" alt=""></button>`).join('')}</div>`;
 document.body.appendChild(box);document.body.style.overflow='hidden';
 const img=box.querySelector('.lbMain'),count=box.querySelector('.lbCount'),ths=[...box.querySelectorAll('.lbThumb')];
 const go=n=>{i=(n+list.length)%list.length;img.src=list[i];count.textContent=`${i+1} / ${list.length}`;ths.forEach((t,k)=>t.classList.toggle('on',k===i));ths[i].scrollIntoView({block:'nearest',inline:'center',behavior:'smooth'})};
 const close=()=>{box.remove();document.body.style.overflow='';document.removeEventListener('keydown',key)};
 const key=e=>{if(e.key==='Escape')close();else if(e.key==='ArrowLeft')go(i-1);else if(e.key==='ArrowRight')go(i+1)};
 document.addEventListener('keydown',key);
 box.querySelector('.lbClose').onclick=close;
 box.querySelectorAll('.lbNav').forEach(b=>b.onclick=()=>go(i+Number(b.dataset.d)));
 ths.forEach(t=>t.onclick=()=>go(Number(t.dataset.k)));
 box.querySelector('.lbStage').onclick=e=>{if(e.target.classList.contains('lbStage'))close()};
