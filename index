<body>
<header><div class="logo">설정 관리<span style="color:#b3b4aa">.</span></div><nav class="nav"><button data-view="characters" class="on">캐릭터</button><button data-view="worlds">세계관</button><button data-view="relations">관계</button><button data-view="overview">전체 현황</button></nav><div class="right"><button class="btn" id="backup">백업</button><button class="btn dark" id="newMain">+ 새 캐릭터</button></div></header>
<main id="main"></main>
<input type="file" id="restoreInput" accept=".json" class="hidden">
<div id="modal"></div>
<script>
const KEY='setting-manager-v2-data';
const blank=()=>({worlds:[],characters:[],relations:[],affiliations:[],relationFolders:[]});
let db=blank(),view='characters',filter='all',query='',drawerTab='basic',editing=null,detailId=null,relationFolderFilter='all';
try{let saved=JSON.parse(localStorage.getItem(KEY));if(saved&&Array.isArray(saved.characters)){db={...blank(),...saved};db.affiliations ||= [];db.relationFolders ||= []}}catch(e){}
const save=()=>{try{localStorage.setItem(KEY,JSON.stringify(db))}catch(e){alert('저장 공간이 부족합니다. 이미지 용량을 줄이거나 백업 파일로 저장해 주세요.')}};
const compressImage=(file,max=1600,q=.85)=>new Promise((res,rej)=>{const url=URL.createObjectURL(file);const im=new Image();im.onload=()=>{let w=im.naturalWidth,h=im.naturalHeight;const s=Math.min(1,max/Math.max(w,h));w=Math.round(w*s);h=Math.round(h*s);const cv=document.createElement('canvas');cv.width=w;cv.height=h;cv.getContext('2d').drawImage(im,0,0,w,h);URL.revokeObjectURL(url);let out=cv.toDataURL('image/webp',q);if(!out.startsWith('data:image/webp'))out=cv.toDataURL('image/jpeg',q);res(out)};im.onerror=()=>{URL.revokeObjectURL(url);rej(new Error('img'))};im.src=url});
const id=()=>Math.random().toString(36).slice(2)+Date.now().toString(36);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const worldName=x=>db.worlds.find(w=>w.id===x)?.name||'미분류';
const charName=x=>db.characters.find(c=>c.id===x)?.name||'삭제된 캐릭터';
const el=document.getElementById('main');
function nav(v){view=v;filter='all';query='';document.querySelectorAll('[data-view]').forEach(x=>x.classList.toggle('on',x.dataset.view===v));render()}
document.querySelectorAll('[data-view]').forEach(x=>x.onclick=()=>nav(x.dataset.view));
document.getElementById('newMain').onclick=()=>editCharacter();
document.getElementById('backup').onclick=()=>{let blob=new Blob([JSON.stringify({...db,version:2},null,2)],{type:'application/json'});let a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='설정관리_백업_'+new Date().toISOString().slice(0,10)+'.json';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)};
function render(){
if(view==='characters')renderCharacters();
if(view==='worlds')renderWorlds();
if(view==='relations')renderRelations();
if(view==='overview')renderOverview();
if(view==='detail')renderDetail();
if(view==='relation-editor')renderRelationEditor();
if(view==='relation-detail')renderRelationDetail();
}
function renderCharacters(){
let arr=db.characters.filter(c=>(filter==='all'||c.worldId===filter)&&[c.name,c.alias,c.species,c.role,c.tags,c.affiliation,c.summary].join(' ').toLowerCase().includes(query.toLowerCase()));
el.innerHTML=`<div class="hero"><div><div class="eyebrow">CHARACTERS / 캐릭터 목록</div><h1>캐릭터</h1><div class="muted">만든 캐릭터를 모아보고 설정을 정리합니다. 카드를 끌어서 순서를 바꿀 수 있어요.</div></div><button class="btn dark" id="addChar">+ 캐릭터 추가</button></div>
<div class="toolbar"><input class="search" id="search" placeholder="이름, 소속, 태그로 검색" value="${esc(query)}"><button class="chip ${filter==='all'?'active':''}" data-filter="all">전체</button>${db.worlds.map(w=>`<button class="chip ${filter===w.id?'active':''}" data-filter="${esc(w.id)}">${esc(w.name)}</button>`).join('')}<span class="count">${arr.length}명</span></div>
<div class="cards">${arr.length?arr.map(c=>`<article class="character" data-char="${esc(c.id)}"><div class="portrait" data-no="${String(db.characters.indexOf(c)+1).padStart(2,'0')}">${c.image?`<img src="${c.image}" alt="">`:`<span class="initial">${esc((c.name||'?').slice(0,1))}</span>`}<span class="flag">${esc(worldName(c.worldId))}</span></div><div class="cardbody"><h3>${esc(c.name)}</h3><p>${esc([c.species,c.affiliation].filter(Boolean).join(' · ')||'정보 없음')}</p><div class="tags">${(c.tags||'').split(',').map(x=>x.trim()).filter(Boolean).slice(0,4).map(t=>`<span class="tag">${esc(t)}</span>`).join('')}</div></div></article>`).join(''):`<div class="empty"><div style="font-size:28px;margin-bottom:12px">◇</div>${query?'검색 결과가 없습니다.':'아직 등록된 캐릭터가 없습니다.'}<p class="tiny">캐릭터를 추가하면 이곳에 카드로 표시됩니다.</p><button class="btn dark" id="emptyAdd">캐릭터 추가</button></div>`}</div>`;
document.getElementById('addChar').onclick=()=>editCharacter();
document.getElementById('emptyAdd')?.addEventListener('click',()=>editCharacter());
document.getElementById('search').oninput=e=>{let pos=e.target.selectionStart;query=e.target.value;renderCharacters();let inp=document.getElementById('search');inp.focus();inp.setSelectionRange(pos,pos)};
document.querySelectorAll('[data-filter]').forEach(b=>b.onclick=()=>{filter=b.dataset.filter;renderCharacters()});
document.querySelectorAll('[data-char]').forEach(b=>b.onclick=()=>{if(suppressClick)return;showCharacter(b.dataset.char)});
}
function renderWorlds(){el.innerHTML=`<div class="hero"><div><div class="eyebrow">WORLDS / 세계관 목록</div><h1>세계관</h1><div class="muted">캐릭터들이 속한 세계와 배경을 관리합니다.</div></div><button class="btn dark" id="addWorld">+ 세계관 추가</button></div><div class="worldgrid">${db.worlds.map(w=>`<div class="worldcard" data-world="${esc(w.id)}"><div class="eyebrow">WORLD · ${db.characters.filter(c=>c.worldId===w.id).length}명</div><h3>${esc(w.name)}</h3><p>${esc(w.description||'설명이 없습니다.')}</p></div>`).join('')}<div class="worldcard" id="worldCreate" style="border-style:dashed;text-align:center;color:var(--sub)"><h3>+ 새 세계관</h3><p>세계관 이름과 설정 추가</p></div></div>`;document.getElementById('addWorld').onclick=()=>editWorld();document.getElementById('worldCreate').onclick=()=>editWorld();document.querySelectorAll('[data-world]').forEach(x=>x.onclick=()=>editWorld(x.dataset.world))}
function renderRelations(){
const groups=db.relationFolders||[];
const list=db.relations.filter(r=>relationFolderFilter==='all'||(r.folderId||'')===relationFolderFilter);
el.innerHTML=`<div class="hero"><div><div class="eyebrow">RELATIONSHIPS / 캐릭터 관계</div><h1>관계</h1><div class="muted">폴더별로 캐릭터 관계를 정리합니다. 카드를 누르면 관계 내용을 볼 수 있어요.</div></div><div class="heroActions"><button class="btn" id="addFolder">+ 폴더</button><button class="btn dark" id="addRel">+ 관계 추가</button></div></div>
<div class="toolbar folderbar"><button class="chip ${relationFolderFilter==='all'?'active':''}" data-folder="all">전체 (${db.relations.length})</button><button class="chip ${relationFolderFilter===''?'active':''}" data-folder="">미분류</button>${groups.map(f=>`<button class="chip ${relationFolderFilter===f.id?'active':''}" data-folder="${esc(f.id)}">${esc(f.name)} (${db.relations.filter(r=>r.folderId===f.id).length})</button>`).join('')}</div>
<div class="relationList">${list.length?list.map(r=>`<button class="relationListItem" data-rel-view="${esc(r.id)}"><span class="relationListMain"><strong>${esc(r.pairName?.trim()||`${charName(r.from)} → ${charName(r.to)}`)}</strong><span class="relationListSub">${esc(r.type||'관계')} · ${esc(db.relationFolders.find(f=>f.id===r.folderId)?.name||'미분류')}</span></span><span class="relationListArrow">상세 보기 →</span></button>`).join(''):'<div class="empty">이 폴더에 등록된 관계가 없습니다.</div>'}</div>
${relationFolderFilter!=='all'&&relationFolderFilter!==''?'<button class="btn red" id="deleteFolder" style="margin-top:20px">현재 폴더 삭제</button>':''}`;
document.getElementById('addRel').onclick=()=>editRelation();
document.getElementById('addFolder').onclick=()=>{let name=prompt('관계 폴더 이름');if(!name||!name.trim())return;let f={id:id(),name:name.trim()};db.relationFolders.push(f);relationFolderFilter=f.id;save();render()};
document.querySelectorAll('[data-folder]').forEach(b=>b.onclick=()=>{relationFolderFilter=b.dataset.folder;render()});
document.querySelectorAll('[data-rel-view]').forEach(x=>x.onclick=()=>showRelation(x.dataset.relView));
document.getElementById('deleteFolder')?.addEventListener('click',()=>{if(confirm('폴더를 삭제할까요? 관계 기록은 미분류로 이동합니다.')){db.relationFolders=db.relationFolders.filter(f=>f.id!==relationFolderFilter);db.relations.forEach(r=>{if(r.folderId===relationFolderFilter)r.folderId=''});relationFolderFilter='all';save();render()}});
