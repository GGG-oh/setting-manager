<section class="wikiIntro"><h2>개요</h2><div class="wikiProse">${esc(c.summary||'아직 작성된 소개가 없습니다.')}</div>${c.tags?`<div class="tags">${c.tags.split(',').filter(Boolean).map(t=>`<span class="tag">${esc(t.trim())}</span>`).join('')}</div>`:''}</section>
${blocks.map(([k,t,content],i)=>`<section class="wikiSection" id="section-${k}"><h2><span class="wikiSectionNumber">${i+1}.</span> ${t}</h2>${content}</section>`).join('')}
